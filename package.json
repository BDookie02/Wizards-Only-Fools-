{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "cert:lan": "powershell -ExecutionPolicy Bypass -File scripts/ensure-lan-cert.ps1",
    "dev:https": "npm run cert:lan && node server.js --https",
    "build": "node verify_sprites.js && vite build",
    "test:integration": "node scripts/integration-smoke.mjs",
